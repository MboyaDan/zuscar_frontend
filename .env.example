# Copy to .env.local for local work:  cp .env.example .env.local   (.env.local is git-ignored)
# On Vercel set the same names under Project Settings > Environment Variables.

# The public address of THIS web app. Used for absolute URLs and metadata.
# Local: http://localhost:3000    Vercel: your https production URL or custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shows the "Test environment" banner unless this is exactly "production".
NEXT_PUBLIC_APP_ENV=development

# Where the Go backend lives. Server-side only (never sent to the browser) and read at BUILD time.
# Local (backend in Docker, port published on 8080): http://localhost:8080
# Vercel: your Render service URL, for example https://zuscar-api.onrender.com  (then redeploy)
BACKEND_URL=http://localhost:8080
