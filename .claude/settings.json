{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git switch:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr list:*)",
      "Bash(npm ci)", "Bash(npm run lint)", "Bash(npm run build)", "Bash(npx tsc --noEmit)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Read(./.env)", "Read(./.env.*)"
    ]
  }
}
